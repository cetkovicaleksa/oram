root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{toml,yaml,yml,bib}]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.{csv}]
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false

[*.{md}]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 80

[*.{typ,typst}]
# using tpstyle formatter
indent_size = 2
trim_trailing_whitespace = false
